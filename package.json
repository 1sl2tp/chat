{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:local": "tsc -p tsconfig.local.json",
    "build:local": "node scripts/build-local.mjs",
    "test": "npm run compile:local --silent && node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build:local",
    "build": "npm run typecheck && npm test && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "livekit-client": "2.22.1"
  }
}
